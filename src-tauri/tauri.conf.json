{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FocusLens",
  "version": "0.1.0",
  "identifier": "com.focuslens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FocusLens",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../cv/main.py": "cv/main.py",
      "../cv/requirements.txt": "cv/requirements.txt",
      "../cv/app/*.py": "cv/app/",
      "../cv/config/*.py": "cv/config/",
      "../cv/models/*.py": "cv/models/",
      "../cv/models/*.task": "cv/models/",
      "../cv/services/*.py": "cv/services/",
      "../cv/utils/*.py": "cv/utils/"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:focuslens.db"]
    }
  }
}
